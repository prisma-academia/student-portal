# Default school (abnaibi). Only these four values differ per school;
# everything else is derived in src/configs.js. Values are public: Vite
# bakes them into the bundle, so this file is committed.
# Other schools: `vite build --mode <school>` loads .env.<school> on top.
# Quote hex colours: an unquoted # starts a comment in .env files.
VITE_API_BASE_URL=https://api.abnacnm.edu.ng
VITE_APP_NAME=ABNAIBI
VITE_LOGO_URL=https://storage.prismaforge.name.ng/abnaibi/static_assets/android-chrome-192x192.png
VITE_PRIMARY_COLOR="#f44336"
