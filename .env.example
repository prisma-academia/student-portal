# All variables below are REQUIRED. No fallbacks; app errors on missing env.
# Copy to .env and set every value.

# API
VITE_API_BASE_URL=https://api.abnacnm.edu.ng

# Branding – app identity
VITE_APP_NAME=ABNAIBI
VITE_APP_SHORT_NAME=ABNAIBI
VITE_PAGE_TITLE=Portal

# Branding – logo & favicon
VITE_LOGO_URL=https://example.com/logo.png
VITE_LOGO_ALT=Logo
VITE_FAVICON_PATH=/favicon/favicon.ico

# Branding – theme (6-digit hex, e.g. #f44336)
VITE_PRIMARY_COLOR=#f44336

# Branding – PWA / manifest
VITE_THEME_COLOR=#ffffff
VITE_MANIFEST_BG_COLOR=#ffffff

# Branding – auth layout
VITE_AUTH_BACKGROUND_URL=https://abnacnm.edu.ng/assets/images/home6/academics/hostel.jpeg
VITE_AUTH_BACKGROUND_URL_DARK=https://images.unsplash.com/photo-1572072393749-3ca9c8ea0831?auto=format&w=1000&dpr=2
VITE_FOOTER_TEXT=© Prisma Forge {year}

# Branding – calendar category colors
VITE_CALENDAR_DEPARTMENT_BG=rgb(248, 157, 157)
VITE_CALENDAR_DEPARTMENT_HOVER=rgb(252, 176, 176)
VITE_CALENDAR_CLASS_BG=rgb(190, 248, 157)
VITE_CALENDAR_CLASS_HOVER=rgb(204, 250, 177)
VITE_CALENDAR_GENERAL_BG=rgb(157, 195, 248)
VITE_CALENDAR_GENERAL_HOVER=rgb(138, 182, 245)
